{
  "name": "cinesync",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace cinesync-next",
    "build": "npm run build --workspace cinesync-next",
    "start": "npm run start --workspace cinesync-next",
    "lint": "npm run lint --workspace cinesync-next",
    "mobile": "npm run start --workspace cinesync-mobile",
    "mobile:ios": "npm run ios --workspace cinesync-mobile",
    "mobile:android": "npm run android --workspace cinesync-mobile",
    "check:tokens": "node scripts/check-tokens.mjs",
    "mobile:typecheck": "npm run typecheck --workspace cinesync-mobile",
    "verify": "npm run check:tokens && npm run build && npm run mobile:typecheck"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
