# TMDB API key (https://www.themoviedb.org/settings/api).
# Optional: the app ships with a working fallback key, and all TMDB calls
# happen server-side, so this value never reaches the browser.
TMDB_API_KEY=
# Optional: absolute origin used to resolve the social card in app/opengraph-image.png.
# Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# ---- Accounts (Supabase) ----------------------------------------------------
# Create a project at https://supabase.com, then Settings -> API for these two.
# Both are public by design: the anon key identifies the project, it does not
# authorise anything. Row-level security in the database is what protects data.
# Without them the app runs exactly as before, minus sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, and it bypasses row-level security completely. Never give this
# one a NEXT_PUBLIC_ prefix — that inlines it into the browser bundle as
# plaintext, the same trap CLAUDE.md documents for EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, and missing from this file for a long time, which is how it became
# undiscoverable: enriches the details panel with Rotten Tomatoes / Metacritic.
OMDB_API_KEY=
